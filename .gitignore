# Root-level Git ignore for GigSurance

# Python
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.py[cod]
backend/*.pyo
backend/*.pyd
backend/.Python
backend/env/
backend/.env
backend/.pytest_cache/
backend/.mypy_cache/
backend/htmlcov/

# Node/Vite
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
Frontend/build/
Frontend/.cache/
Frontend/.env
Frontend/.env.*
Frontend/package-lock.json
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/pnpm-debug.log*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# # Logs
# *.log
# npm-debug.log*
# yarn-debug.log*
# pnpm-debug.log*

# Temporary
*.tmp
*.temp
